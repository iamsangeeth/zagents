# Local Compose configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-local-password
POSTGRES_DB=parikzan

# Keep public content in sibling Parikzen repository.
Q_AI_CONTENT_DIR=../../q_ai/content/blog

# Host Ollama reachable from Podman container network.
OLLAMA_BASE_URL=http://host.containers.internal:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-key

OPENWEBUI_PORT=8080
WEBUI_AUTH=true
PARIKZAN_API_PORT=8000
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
